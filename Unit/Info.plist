<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSHealthShareUsageDescription</key>
	<string>Unit does not read your Apple Health data. It only saves finished workouts there when you turn this on in Settings.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Unit saves each finished workout to Apple Health as strength training.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>TelemetryDeckAppID</key>
	<string>$(TELEMETRYDECK_APP_ID)</string>
	<key>UIAppFonts</key>
	<array>
		<string>Geist-Medium.ttf</string>
		<string>Geist-SemiBold.ttf</string>
		<string>Geist-Bold.ttf</string>
		<string>GeistMono-Medium.ttf</string>
		<string>GeistMono-SemiBold.ttf</string>
		<string>GeistMono-Bold.ttf</string>
	</array>
</dict>
</plist>
